{
  "name": "@taxi/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Sakta Cab shared contracts: schemas, ride state machine, enums, provider seams",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,tests}/**/*.ts\" vitest.config.ts --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@taxi/config": "workspace:*",
    "eslint": "^9.18.0",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}

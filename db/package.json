{
  "name": "@taxi/db",
  "version": "0.0.1",
  "private": true,
  "description": "Sakta Cab persistence layer: Drizzle schema, PostGIS migrations, R\u012bga pilot seed",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,tests}/**/*.ts\" drizzle.config.ts vitest.config.ts --max-warnings 0",
    "pretest": "docker compose -f ../docker-compose.yml up -d --wait db",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "migrate:run": "tsx src/migrate-run.ts",
    "seed": "tsx src/seed/run.ts"
  },
  "dependencies": {
    "@taxi/shared": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@taxi/config": "workspace:*",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.18.0",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}

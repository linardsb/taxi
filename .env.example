# Copy to .env and fill in. Only what's needed to boot locally; secrets never committed.

# --- database & cache (docker-compose defaults) ---
DATABASE_URL=postgres://taxi:taxi@localhost:5432/taxi
REDIS_URL=redis://localhost:6379

# --- api ---
API_PORT=3001
JWT_SECRET=dev-only-change-me

# --- Google Maps Platform (console.cloud.google.com → APIs: Geocoding, Routes, Maps SDKs) ---
GOOGLE_MAPS_API_KEY=

# --- Twilio SMS OTP (console.twilio.com) — leave empty in dev: OTP falls back to console log ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Stripe (dashboard.stripe.com → test mode keys until the SIA exists) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

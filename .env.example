# Copy to .env and fill in. Only what's needed to boot locally; secrets never committed.

# --- database & cache (docker-compose defaults) ---
DATABASE_URL=postgres://taxi:taxi@localhost:5432/taxi
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# These two are INDEPENDENT — compose publishes on REDIS_PORT, the API dials
# REDIS_URL, and neither is derived from the other. If 6379 is taken on your
# machine, change BOTH or the API stays pointed at whatever else holds it:
#   REDIS_PORT=6381
#   REDIS_URL=redis://localhost:6381
# Your actual port is the host side of `->6379/tcp` in:
#   COMPOSE_PROJECT_NAME=taxi docker compose ps
# The symptom of a mismatch is NOT ECONNREFUSED — whatever holds 6379 usually
# answers. A password-protected server there gives a scroll of `NOAUTH
# Authentication required`, and RedisIoAdapter.connectToRedis assigns its two
# clients only after both ping, so a boot hangs with the real error buried.
# REDIS_TEST_URL is deliberately absent: nothing loads this file for jest (the
# specs read process.env directly), so setting it here would be inert. Export
# it in the shell to match REDIS_PORT or the Redis suites describe.skip.

# --- api ---
API_PORT=3001
# Both values below are PUBLIC — they are committed here. NODE_ENV=production
# refuses to boot on either, on anything under 32 chars, or on the two being
# equal. Generate each separately: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
# Peppers the OTP hash and nothing else. Separate from JWT_SECRET so rotating
# the signing key does not invalidate every OTP in flight.
OTP_PEPPER=dev-only-otp-pepper
JWT_EXPIRES_IN=30d
# The pilot city (db seed: RIGA_CITY_ID). Dispatchers are placed in dispatch:<this>.
DEFAULT_CITY_ID=00000000-0000-4000-8000-000000000001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Where SMS tracking links point (#63): the dispatch web app's public origin,
# which serves /t/:token. Dev default = its dev origin.
PUBLIC_TRACKING_BASE_URL=http://localhost:3000

# --- dispatch web app ---
# Where the tracking page's server side reaches the API (SSR fetch + /t/:token/data proxy).
API_URL=http://localhost:3001

# --- Google Maps Platform (console.cloud.google.com → APIs: Geocoding, Routes, Maps SDKs) ---
GOOGLE_MAPS_API_KEY=
# How long a routed leg stays cached — THE knob behind the <€100/mo guardrail.
MAPS_ROUTE_CACHE_TTL_SECONDS=86400
# The tracking page's own seam: a shorter TTL (it reads durationSeconds, which traffic
# moves), and a negative cache so an outage costs one call per corridor per minute
# rather than one per poll per viewer. Both apply to the ETA caller ONLY — pricing
# deliberately does not negative-cache, or one blip would block bookings on a corridor.
MAPS_ETA_CACHE_TTL_SECONDS=300
MAPS_ETA_FAILURE_TTL_SECONDS=60
# BOTH callers, pricing included — not just the tracking page. Bounds latency, not
# spend (the upstream call keeps running and still bills). Lower it to make the
# tracking page fail faster and you also fail every quote, i.e. every booking.
MAPS_ROUTE_TIMEOUT_MS=3000

# --- Twilio SMS (console.twilio.com) — all three set together or none (#85, schema-enforced).
# Empty in dev: OTP + ride SMS fall back to the console-logging stub.
# TWILIO_FROM_NUMBER = an alphanumeric sender ID (SaktaCab, ≤11 chars — free, no LV
# registration, paid accounts only) or an E.164 number (trials must use their trial number). ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Stripe (dashboard.stripe.com → test mode keys until the SIA exists) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
